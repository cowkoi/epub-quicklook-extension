<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Quick Look extensions must be sandboxed. Quick Look grants read access to
	     the previewed file itself; no other file access is requested. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Required for WKWebView to start its networking process inside a sandboxed
	     extension, even though all content is served from a custom URL scheme.
	     The pages' Content-Security-Policy blocks every network request. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
